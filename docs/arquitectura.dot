digraph G {
  rankdir=LR; splines=spline; nodesep=0.3; ranksep=1.0; dpi=160;
  graph [fontname="Helvetica", fontsize=13, label="EduConnect - Arquitectura de la PoC con API Gateway", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];

  cliente [label="Cliente externo\nportal-externo-demo\n(curl en el equipo local)", fillcolor="#E8F0FE"];

  subgraph cluster_docker {
    label="Docker Compose - red bridge interna \"educonnect\""; style="rounded,dashed"; margin=16;
    kong [label="Kong Gateway 3.9.5 (DB-less, kong.yml)\l\lPolíticas:\l- key-auth global: cabecera X-API-Key\l- rate-limiting (consumidor): 5/min compartidas\l  entre estudiantes, matrículas y pagos\l- rate-limiting (consumidor + ruta certificados):\l  3/min, contador propio\l- contadores en memoria (policy: local)\l", fillcolor="#FFF4CE"];
    est [label="Mock estudiantes\nestudiantes:3000/estudiantes", fillcolor="#E6F4EA"];
    mat [label="Mock matrículas\nmatriculas:3000/matriculas", fillcolor="#E6F4EA"];
    pag [label="Mock pagos\npagos:3000/pagos", fillcolor="#E6F4EA"];
    cer [label="Mock certificados\ncertificados:3000/certificados", fillcolor="#E6F4EA"];
  }

  cliente -> kong [label="HTTP\n127.0.0.1:8000"];
  kong -> est [label="/api/estudiantes"];
  kong -> mat [label="/api/matriculas"];
  kong -> pag [label="/api/pagos"];
  kong -> cer [label="/api/certificados"];
}
